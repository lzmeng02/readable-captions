{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read(*)",
      "Edit(src/**)",
      "Edit(public/**)",
      "Edit(scripts/**)",
      "Edit(tests/**)",
      "Edit(test/**)",
      "Edit(package.json)",
      "Edit(package-lock.json)",
      "Edit(pnpm-lock.yaml)",
      "Edit(yarn.lock)",
      "Edit(tsconfig.json)",
      "Edit(vite.config.*)",
      "Edit(eslint.config.*)",
      "Edit(prettier.config.*)",
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(git config *)",
      "Bash(git --version)"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(git push)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git stash drop *)",
      "Bash(rm -rf *)",
      "Bash(del *)",
      "Bash(Remove-Item *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(Invoke-WebRequest *)",
      "Bash(irm *)",
      "Bash(iwr *)",
      "Read(.env)",
      "Read(.env.*)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Read(**/secrets/**)",
      "Edit(**/secrets/**)",
      "Edit(.git/**)",
      "Edit(node_modules/**)",
      "Edit(dist/**)",
      "Edit(build/**)",
      "Edit(coverage/**)"
    ],
    "ask": [
      "Bash(npm install *)",
      "Bash(npm uninstall *)",
      "Bash(pnpm add *)",
      "Bash(pnpm remove *)",
      "Bash(yarn add *)",
      "Bash(yarn remove *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git stash *)",
      "Bash(mkdir *)",
      "Bash(mv *)",
      "Bash(cp *)",
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(gh pr merge *)",
      "Bash(npm publish *)",
      "Edit(.github/**)",
      "Edit(.vscode/**)",
      "Edit(.claude/**)"
    ],
    "defaultMode": "acceptEdits"
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true
  }
}
